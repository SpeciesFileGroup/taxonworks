FROM postgis/postgis:17-3.5

ENV POSTGRES_HOST_AUTH_METHOD=trust

RUN {\
  echo "psql -U postgres -c 'CREATE ROLE test SUPERUSER CREATEDB CREATEROLE INHERIT LOGIN;' && \
        psql -U postgres -c 'CREATE DATABASE test;' && \
        psql -U postgres -c 'CREATE DATABASE solid;' && \
        psql -U test -c 'CREATE EXTENSION postgis; CREATE EXTENSION postgis_topology;'"; \
} > /docker-entrypoint-initdb.d/test.sh
