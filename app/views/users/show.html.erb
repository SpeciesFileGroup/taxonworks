<div id="user-profile">
  <div class="container-xl mx-auto">
    <div class="profile-header">
      <div class="profile-info">
        <%= user_avatar(@user) -%>
        <div class="user-details">
          <h1>
            <span id="user_name"><%= @user.name -%></span>
            <% if sessions_current_user_id == @user.id %>
            <span class="badge">Current user</span>
            <%end %>
          </h1>
          <p class="email cursor-pointer" id="user-email" title="Copy to clipboard"><%= @user.email -%></p>
        </div>
      </div>

      <%= link_to edit_user_path(@user), class: "button btn-primary btn-link btn-medium-size edit-btn" do %>
        <%= icon('pen', size: 14) %>
        Edit
      <% end %>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-value"><%= @user.is_administrator? ? 'Administrator' : 'User' -%></span>
        <span class="stat-label">Role</span>
        <span class="stat-watermark">
          <%= icon('shield', size: 16) %>
        </span>
      </div>

      <div class="stat-card">
        <span class="stat-value"><%= user_time_active(@user) -%></span>
        <span class="stat-label">Time active</span>
        <span class="stat-watermark">
          <%= icon('clock', size: 16) %>
        </span>
      </div>

      <div class="stat-card">
        <span class="stat-value"><%= @user.sign_in_count -%></span>
        <span class="stat-label">Sign in count</span>
        <span class="stat-watermark">
          <%= icon('log-in', size: 16) %>
        </span>
      </div>

      <div class="stat-card">
        <span class="stat-value"><%= @user.created_at.strftime("%Y-%m-%d") -%></span>
        <span class="stat-label">Member since</span>
        <span class="stat-watermark">
          <%= icon('calendar', size: 16) %>
        </span>
      </div>
    </div>

    <div class="profile-grid">
      <div class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('user', size: 18) %>
          </span>
          <h2 class="tw-card-title">User Profile</h2>
        </div>
        <div class="tw-card-body">
          <div class="info-grid">
            <div class="info-item">
              <span class="info-label">Person</span>
              <span class="info-value link">
                <%= person_link(@user.person) %>
              </span>
            </div>
            <div class="info-item">
              <span class="info-label">Created by</span>
              <span class="info-value">
                <%= user_tag(@user.creator) %>
              </span>
            </div>
            <div class="info-item">
              <span class="info-label">ORCID</span>
                <% if @user.orcid %>
                  <%= link_to(@user.orcid, @user.orcid , class: 'info-value link', target: '_blank') -%>
                <% else %>
                  <%= content_tag(:span, 'NONE (add to Person)', class: 'info-value muted') -%>
                <% end %>
            </div>
            <div class="info-item">
              <span class="info-label">Wikidata ID</span>
                <% if @user.wikidata_id %>
                  <%= link_to("https://www.wikidata.org/wiki/#{@user.wikidata_id}", @user.wikidata_id , class: 'info-value link', target: '_blank') -%>
                <% else %>
                  <%= content_tag(:span, 'NONE (add to Person)', class: 'info-value muted') -%>
                <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('activity', size: 18) %>
          </span>
          <h2 class="tw-card-title">Session History</h2>
        </div>
        <div class="tw-card-body">
          <div class="session-item current">
            <div class="session-left">
              <span class="session-dot active"></span>
              <span class="session-type">Current sign in</span>
            </div>
            <div class="session-right">
              <div class="session-date"><%= @user.current_sign_in_at.strftime("%B %d, %Y at %I:%M %p") if @user.current_sign_in_at %></div>
              <div class="session-ip">IP: <%= @user.current_sign_in_ip %></div>
            </div>
          </div>
          <div class="session-item previous">
            <div class="session-left">
              <span class="session-dot inactive"></span>
              <span class="session-type">Last sign in</span>
            </div>
            <div class="session-right">
              <div class="session-date"><%= @user.last_sign_in_at.strftime("%B %d, %Y at %I:%M %p") if @user.last_sign_in_at %></div>
              <div class="session-ip">IP: <%= @user.last_sign_in_ip %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% if @user.api_access_token %>
    <div class="tw-card">
      <div class="tw-card-header">
        <span class="card-icon-chip">
          <%= icon('key', size: 18) %>
        </span>
        <h2 class="tw-card-title">API Access Token</h2>
      </div>
      <div class="tw-card-body">
        <div class="token-container">
          <input type="password" class="token-input" value="<%= @user.api_access_token %>" readonly id="tokenInput">
          <button class="token-btn" id="toggle-token-btn" title="Show/Hide">
            <%= icon('show', size: 18) %>
          </button>
          <button class="token-btn" id="copy-token-btn" title="Copy to clipboard">
            <%= icon('copy', size: 18) %>
          </button>
        </div>
        <div class="token-warning">
          <%= icon('alert-circle', size: 16) %>
          Never share your API token. Keep it safe and confidential.
        </div>
      </div>
    </div>
  <% end %>


 <div class="tw-card">
      <div class="tw-card-header">
        <span class="card-icon-chip">
          <%= icon('code') %>
        </span>
        <h2 class="tw-card-title">Preferences</h2>
      </div>
      <div class="tw-card-body">
        <div class="preferences-grid">
          <div class="preference-section">
            <div class="preference-header">
              <span class="preference-title">General</span>
        <%= form_for @user, url: reset_preferences_user_path(@user), method: :patch, html: { id: 'reset-preferences' } do |f| %>
          <%= f.button "Reset",
            class: "button btn-medium-size btn btn-update",
            data: { confirm: "Warning, this will reset all preferences aross all projects" }
          %>
        <% end %>
            </div>


            <div class="code-block">
<%= JSON.pretty_generate(@user.preferences).html_safe %>
            </div>
          </div>
          <% if sessions_current_project.present? %>
          <div class="preference-section">
            <div class="preference-header">
              <span class="preference-title">Favorites</span>
              <%= form_for @user, url: reset_hub_favorites_user_path(@user), method: :patch, html: { id: 'reset-favorites' } do |f| %>
                <%= f.button "Reset (for #{sessions_current_project.name})",
                  class: "button btn-medium-size btn btn-update",
                  data: { confirm: "Clears your favorite cards for this project" }
                %>
              <% end %>
            </div>
            <div class="code-block">
<%= JSON.pretty_generate(@user.hub_favorites).html_safe %>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <% if sessions_current_user.is_administrator? %>
      <div class="admin-card">
        <div class="tw-card-header flex-row flex-separate">
          <div class="middle gap-small">
            <span class="card-icon-chip">
              <%= icon('shield', size: 18) %>
            </span>
            <h2 class="tw-card-title">Administration</h2>
          </div>
          <span class="admin-badge">Not visible to user</span>
        </div>
        <div class="tw-card-body">
          <div class="admin-section margin-large-bottom">
            <div class="admin-section-title">
              <%= icon('file-text', size: 14) %>
              User data
            </div>
            <div class="admin-links">
              <a href="#" class="admin-link">Created</a>
              <span>/</span>
              <a href="#" class="admin-link">Updated</a>
            </div>
          </div>

          <div class="admin-grid">
            <div class="admin-section">
              <div class="admin-section-title">
              <%= icon('folder', size: 14) %>
                User's projects
              </div>
              <div class="project-list">
                <% if @user.projects.any? %>
                  <%= @user.projects.order(:name).collect{|n| content_tag(:div, link_to(n.name, select_project_path(n), class: 'project-item'))}.join.html_safe %>
                <% else %>
                  <div><i>None</i></div>
                <% end %>
              </div>
            </div>


            <div class="admin-section">
              <div class="admin-section-title">
                <%= icon('database', size: 14) %>
                User's data in projects (quick, not comprehensive)
              </div>
              <div class="data-list">
                <% p = @user.data_in_projects %>
                <% if p.count > 0 %>
                  <%= p.collect{|n| content_tag(:div, n, class: 'data-item')}.join.html_safe %>
                <% else %>
                  <div><i>Not found in core data</i></div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
