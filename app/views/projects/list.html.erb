<div id="project-list" class="tw-list">
  <div class="container-xl mx-auto">
    <div class="tw-card">
      <%= render 'list_controls', position: 'top', show_actions: true %>

      <div class="tw-card-body card-content-table">
        <div class="overflow-x-auto">
          <table class="list-table tablesorter">
            <thead>
              <tr>
                <th class="avatar-col"></th>
                <%= fancy_th_tag(name: 'Name') -%>
                <%= fancy_th_tag(name: 'Total Users') -%>
                <%= fancy_th_tag(name: 'Project Token') -%>
                <%= fancy_th_tag(name: 'Created by', group: 'housekeeping') -%>
                <%= fancy_th_tag(name: 'Updated by', group: 'housekeeping') -%>
                <%= fancy_th_tag(name: 'Last updated', group: 'housekeeping') -%>
              </tr>
            </thead>
            <tbody>
              <% @projects.each do |project| %>
                <%= content_tag(:tr, class: :contextMenuCells) do -%>
                  <td class="avatar-col"><%= project_avatar(project, :small) %></td>
                  <td><%= link_to(project.name, project_path(project), class: 'list-link') %></td>
                  <td><%= project.project_members.count %></td>
                  <td>
                    <% if project.api_access_token.present? -%>
                      <span class="token-cell">
                        <code class="token-code"><%= project.api_access_token %></code>
                        <button type="button" class="token-copy" title="Copy token" data-token="<%= project.api_access_token %>">
                          <%= icon('copy', size: 14) %>
                        </button>
                      </span>
                    <% end -%>
                  </td>
                  <td><%= user_tag(project.creator) %></td>
                  <%= fancy_metadata_cells_tag(project) -%>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%= render 'list_controls', position: 'bottom' %>
    </div>
  </div>
</div>
