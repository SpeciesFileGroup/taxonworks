<div id="dashboard" class="margin-medium-top">
  <div class="container">
    <div class="grid">
      <div class="tw-card panel-projects">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('folder') %>
          </span>
          <h2 class="tw-card-title">Projects</h2>
        </div>
        <div class="tw-card-body">
          <ul class="project-list no_bullets">
            <%= projects_list(@projects) -%>
          </ul>
        </div>
      </div>

      <div class="flex-col full_width">
      <div class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('file-search') %>
          </span>
          <h2 class="tw-card-title">Data Overview</h2>
        </div>
        <div class="tw-card-body">
          <ul class="link-list no_bullets">
            <li>
              <a href="<%= data_user_path(sessions_current_user, target: :created) -%>" class="link-item" data-turbolinks="false">
                <span>Created</span>
              </a>
            </li>
            <li>
              <a href="<%= data_user_path(sessions_current_user, target: :updated) -%>" class="link-item" data-turbolinks="false">
                <span>Updated</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('settings') %>
          </span>
          <h2 class="tw-card-title">Preferences</h2>
        </div>
        <div class="tw-card-body">
          <ul class="link-list no_bullets">
            <% if sessions_current_project_id -%>
              <li><%= link_to('Order hub tabs', order_tabs_hub_path, class: 'link-item' ) -%></li>
            <% else %>
              <li><em>Preferences available when project is set.</em></li>
            <% end %>
          </ul>
      
        </div>
      </div>

      <div class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('info') %>
          </span>
          <h2 class="tw-card-title">Software Information</h2>
        </div>
        <div class="tw-card-body">
          <div class="info-list">
            <div class="info-list-item">
              <span class="info-list-label">Version</span>
              <span class="info-list-value"><%= taxonworks_version_tag -%></span>
            </div>
            <div class="info-list-item">
              <span class="info-list-label">Environment</span>
              <span class="badge badge-<%= current_environment -%>"><%= current_environment -%></span>
            </div>
            <% if Settings.sandbox_mode? %>
            <div class="info-list-item">  
              <div>
                <%= sandbox_details_tag -%>
                <br>
                <%= sandbox_warning_tag -%>
              </div> 
            </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>