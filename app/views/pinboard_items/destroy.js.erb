(() => {
  document.querySelectorAll('[data-pin-button-item-id="<%= @pinboard_item.pinned_object_id -%>"]').forEach((element) => {
    element.outerHTML = "<%= j pin_item_to_pinboard_link(@pinboard_item.pinned_object, sessions_current_user) -%>"
  })

  TW.workbench.pinboard.removeItem(<%= @pinboard_item.id -%>)

  document.querySelectorAll('.mx-spinner').forEach((element) => {
    element.remove()
  })

  TW.workbench.alert.create("Pinboard item was successfully destroyed.", "notice")
})()
