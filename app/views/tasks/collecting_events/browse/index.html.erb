<div id="browse-collecting-event" class="browse-view" data-collecting-event-id="<%= @collecting_event.id %>">
  <div>
    <div id="browse-collecting-event-navbar" class="panel content sticky-navbar rounded-tl-none rounded-tr-none">
      <div class="flex-separate middle">

        <div class="middle gap-medium margin-medium-right">
          <%= form_tag(browse_collecting_events_task_path, method: :get) do %>
            <%= render  'workbench/elements/forms/ajax_select',
              controller: '/collecting_events',
              object: '',
              method: 'collecting_event_id',
              send_select: true,
              tag_id: 'collecting_event_id_for_browse_collecting_event',
              autofocus: true
            %>
          <% end %>
        </div>

        <span class="right_float flex-separate middle">
          <ul class="context-menu">
            <li><%= radial_annotator(@collecting_event) %></li>
            <li><%= confidence_default_icon(@collecting_event) %></li>
            <li><%= tag_default_icon(@collecting_event) %></li>
            <li><%= pin_item_to_pinboard_link(@collecting_event, sessions_current_user) %></li>
            <li><%= link_to('', new_collecting_event_task_path(collecting_event_id: @collecting_event.id), class: "circle-button btn-edit") -%></li>
            <li><%= radial_navigation_tag(@collecting_event) %></li>
          </ul>
        </span>
      </div>
    </div>
  </div>

  <div id="show" class="panels-container gap-medium">
    <div class="nav-column">
      <div class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip"><%= icon('compass') %></span>
          <h2 class="tw-card-title">Navigate</h2>
        </div>
        <div>
          <div class="navigation-controls">
            <%= link_to('Previous', browse_collecting_events_task_path( collecting_event_id: @collecting_event.previous ),class: 'navigation-item') -%>
            <%= link_to('Next', browse_collecting_events_task_path( collecting_event_id: @collecting_event.next ), class: 'navigation-item') -%>
          </div>

          <div class="navigation-controls">
            <%=  collecting_event_browse_previous_by_identifier(@collecting_event) -%>
            <%=  collecting_event_browse_next_by_identifier(@collecting_event) -%>
          </div>
        </div>
      </div>
    </div>

    <div class="main-column flex-col gap-medium full_width">
      <div class="panel full_width">
        <div id="browse-collecting-event-label" class="content subtitle middle browse-record-title">
          <h3 class="item center_text">
            <%= tag.span(collecting_event_tag(@collecting_event), class: :name) -%>
          </h3>
        </div>

        <div class="content">
          <h3 class="tw-section-title">History</h3>
          <div class="collecting_event_history">
            <i> Ultimately a timeline of events related to this collecting event.</i>
            <%#= collecting_event_history_table(@data) -%>
          </div>

          <h3 class="tw-section-title">Details</h3>
          <div class="flexbox gap-medium">
            <div>
              <%= collecting_event_autocomplete_tag(@collecting_event).html_safe %>
              <% similar_count = @collecting_event.similar.count %>
              <p><%= "#{similar_count} similar #{'collecting event'.pluralize(similar_count)}" -%></p>
            </div>
            <div>
              <%= simple_map(@collecting_event.georeferences) -%>
            </div>
          </div>
        </div>
      </div>

      <% if @collecting_event.depictions.any? %>
        <div id="depiction-panel" class="tw-card">
          <div class="tw-card-header">
            <span class="card-icon-chip"><%= icon('image') %></span>
            <h2 class="tw-card-title">Depictions</h2>
          </div>
          <div class="tw-card-body">
            <div class="horizontal-left-content flexbox">
              <%= thumb_list_tag(@collecting_event) -%>
            </div>
          </div>
        </div>
      <% end %>

      <% if @collecting_event.conveyances.any? %>
        <div id="conveyance-panel" class="tw-card">
          <div class="tw-card-header">
            <span class="card-icon-chip"><%= icon('audio-lines') %></span>
            <h2 class="tw-card-title">Conveyances</h2>
          </div>
          <div class="tw-card-body">
            <div class="flex-col gap-medium">
              <%= conveyances_list_tag(@collecting_event) -%>
            </div>
          </div>
        </div>
      <% end %>

      <div id="dwc-panel" class="tw-card">
        <div class="tw-card-header">
          <span class="card-icon-chip"><%= icon('database') %></span>
          <h2 class="tw-card-title">Darwin Core</h2>
        </div>
        <div class="tw-card-body">
          <%= dwc_table(@collecting_event.collection_objects.limit(500)) -%>
        </div>
      </div>
    </div>

    <div id="third-column">
      <div class="flex-wrap-row gap-medium">
        <div id="summary-panel" class="tw-card fullSize">
          <div class="tw-card-header">
            <span class="card-icon-chip"><%= icon('summary') %></span>
            <h2 class="tw-card-title">Summary</h2>
          </div>
          <div class="tw-card-body">
            <div class="info-item">
              <span class="info-label">Collection objects</span>
              <span class="info-value"><%= @collecting_event.collection_objects.count -%></span>
            </div>
          </div>
        </div>

        <% otus = @collecting_event.otus.alphabetically.distinct %>
        <div id="otus-panel" class="tw-card fullSize">
          <div class="tw-card-header">
            <span class="card-icon-chip"><%= icon('list') %></span>
            <h2 class="tw-card-title">OTUs</h2>
          </div>
          <div class="tw-card-body">
            <% if otus.any? %>
              <ul>
                <%= otus.collect{ |o| content_tag(:li, link_to(otu_tag(o), browse_otus_task_path(otu_id: o.id))) }.join.html_safe -%>
              </ul>
            <% else %>
              <em>None</em>
            <% end %>
          </div>
        </div>

        <%= render(partial: '/shared/data/all/show/soft_validation', locals: {object: @collecting_event}) -%>
      </div>
    </div>
  </div>
</div>
