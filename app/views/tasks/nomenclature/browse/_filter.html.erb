<div
  id="browseFilter"
  class="columns-dropdown"
  data-help="Show or hide timeline rows and annotations.">

  <button type="button" class="columns-toggle button btn-outline btn-medium-size" title="Show or hide timeline rows and annotations">
    Display
  </button>

  <div class="columns-menu">

    <label class="columns-menu-item" data-filter-row='[data-history-is-subsequent="true"]'>
      <input type="checkbox" class="columns-checkbox" checked>
      <span class="col-label">History</span>
    </label>

    <label class="columns-menu-item" data-filter-row='[data-history-origin="combination"]'>
      <input type="checkbox" class="columns-checkbox" checked>
      <span class="col-label">Combinations</span>
    </label>

    <label class="columns-menu-item" data-filter-row='[data-history-origin="taxon_name_relationship"]'>
      <input type="checkbox" class="columns-checkbox" checked>
      <span class="col-label">Relationships</span>
    </label>

    <label class="columns-menu-item" data-filter-row=".history__type_information">
      <input type="checkbox" class="columns-checkbox" checked>
      <span class="col-label">Type information</span>
    </label>

    <label class="columns-menu-item" data-filter=".soft_validation_anchor">
      <input type="checkbox" class="columns-checkbox">
      <span class="col-label">Validation</span>
    </label>

    <label class="columns-menu-item" data-filter=".history__origin">
      <input type="checkbox" class="columns-checkbox">
      <span class="col-label">Origin</span>
    </label>

    <button type="button" class="columns-menu-item filter-reset" data-filter-reset="reset">
      <%= icon('rotate-ccw') %>
      <span class="col-label">Reset</span>
    </button>

  </div>
</div>
