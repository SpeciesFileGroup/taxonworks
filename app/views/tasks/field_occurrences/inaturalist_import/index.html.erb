<h1>iNaturalist import</h1>

<div class="panel content">
  <h2>Import observations</h2>
  <p>Enter iNaturalist observation IDs or URLs, one per line. Each line creates a field occurrence with a collecting event and georeference.</p>

  <%= form_with url: submit_inaturalist_import_task_path, method: :post do |f| %>
    <div class="separate-bottom">
      <%= f.label :observation_ids, 'Observation IDs or URLs (one per line)' %>
      <%= f.text_area :observation_ids, rows: 6, style: 'width: 100%; display: block;', placeholder: "99182856\nhttps://www.inaturalist.org/observations/12345678" %>
    </div>

    <div class="separate-bottom">
      <%= f.check_box :use_community_taxon, { checked: true }, '1', '0' %>
      <%= f.label :use_community_taxon, "Use community taxon (uncheck to use observer's own identification instead)" %>
    </div>

    <div class="separate-bottom">
      <%= f.check_box :match_otu_by_name, { checked: false }, '1', '0' %>
      <%= f.label :match_otu_by_name, 'Match OTU by taxon name (tries existing OTU in project first; creates name-only OTU if none found)' %>
    </div>

    <div class="separate-bottom">
      <%= f.check_box :import_images, { checked: false }, '1', '0' %>
      <%= f.label :import_images, 'Import images (CC license only — also creates licensing metadata and copyright holder)' %>
    </div>

    <%= button_tag 'Queue import', type: :submit, class: 'button btn-primary btn btn-default-size' %>
  <% end %>
</div>

<div class="panel content separate-top">
  <div class="flex-separate middle separate-bottom">
    <h2>Recently imported field occurrences</h2>
    <%= link_to 'Refresh', inaturalist_import_task_path, class: 'button btn-primary btn-link btn-default-size' %>
  </div>

  <% if @recent_field_occurrences.empty? %>
    <p>No iNaturalist-sourced field occurrences found in this project yet.</p>
  <% else %>
    <table class="full_width">
      <thead>
        <tr>
          <th>ID</th>
          <th>OTU</th>
          <th>Collecting event</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @recent_field_occurrences.each do |fo| %>
          <tr>
            <td><%= fo.id %></td>
            <td><%= fo.taxon_determinations.first&.otu&.name %></td>
            <td><%= fo.collecting_event&.verbatim_locality %></td>
            <td><%= fo.created_at&.strftime('%Y-%m-%d %H:%M') %></td>
            <td><%= link_to 'Browse', browse_field_occurrence_task_path(field_occurrence_id: fo.id) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
