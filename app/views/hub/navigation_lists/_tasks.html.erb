<%= render "/hub/hub_category_filter" %>
<div id="task_carrousel" class="full_width">
  <div class="task-section">
    <% UserTasks.hub_tasks.each do |task| -%>
      <%= task_card(task) -%>
    <% end %>
    <div class="no-tasks full_width" role="status">
      <div class="hub-empty-state">
        <%= icon('file-search', size: 28, class: 'hub-empty-state-icon') %>
        <p class="hub-empty-state-message">No tasks found</p>
      </div>
    </div>
    <div class="reset-all-filters">
      <div class="restart-background"></div>
      <h1>Reset</h1>
    </div>
  </div>
  <div class="navigation panel">
    <div class="task-nav-list">
    </div>
  </div>
</div>
