<%= render "/hub/hub_category_filter", show_scope_filter: false %>
<div id="data_cards">
  <% Hub::Data::SECTIONS.each do |s| -%>
    <div data-section="<%= s -%>" class="data_section">
      <div class="cards-section">
        <% Hub::Data.visual_items_for(s).each do |i| %>
          <div class="card-container">
            <%= data_card(i) -%>
          </div>
        <% end %>
      </div>
      <div class="hub_section_label">
        <div class="data-controls">
          <a class="cards-up" href="#" data-icon="arrow-up"></a>
          <a class="cards-down" href="#" data-icon="arrow-down"></a>
        </div>
        <h3>
          <%= s -%>
        </h3>
      </div>
      <div data-attribute="empty" role="status">
        <div class="hub-empty-state">
          <%= icon('file-search', size: 28, class: 'hub-empty-state-icon') %>
          <p class="hub-empty-state-message">None</p>
        </div>
        <div class="reset-all-filters">
          <div class="restart-background"></div>
          <h1>Reset</h1>
        </div>
      </div>
    </div>
  <% end %>
</div>

