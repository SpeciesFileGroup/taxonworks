<%# The scope group (Filters/Browse/New) only means something over task cards:
    those categories are assigned in UserTasks, and nothing in
    config/interface/hub/data.yml declares them. Callers rendering data cards
    pass `show_scope_filter: false` so the group is not offered where its only
    possible effect is to empty the grid. -%>
<% show_scope_filter = local_assigns.fetch(:show_scope_filter, true) -%>
<div id="filter">
  <div class="flexbox">
    <div class="item item2">
      <div class="panel tw-card filter-card">
        <div class="tw-card-header">
          <span class="card-icon-chip">
            <%= icon('sliders') %>
          </span>
          <h2 class="tw-card-title">Filters</h2>
          <div class="tw-card-header-actions">
            <button type="button" class="button btn-outline reset" data-filter-category="reset" data-tooltip-content="Clear all filters" data-tooltip-placement="bottom" aria-label="Clear all filters">
              <%= icon('rotate-ccw') %>
            </button>
          </div>
        </div>
        <div class="filter-body">
          <div class="search-row">
            <input type="text" placeholder="Search by card title..." class="item mousetrap" id="search-filter" autocomplete="off" autofocus="true" data-help="Filter cards that contain the provided text in the title.">
          </div>

          <% if show_scope_filter -%>
            <span class="filter-title" data-help="Show only cards that do one kind of thing. Only one can be active at a time.">Show</span>
            <div class="navigation-controls navigation-controls-type filter-scope">
              <% %w{filters browse new}.each do |scope| -%>
                <%= content_tag(:div, 'data-filter-category' => scope, 'data-favorite' => true, 'class' => 'navigation-item') do -%>
                  <%= hub_category_icon(scope) %><%= scope.humanize %><span class="category-count"></span>
                <% end -%>
              <% end %>
            </div>
          <% end -%>

          <span class="filter-title" data-help="Filter cards by category.">Categories</span>
          <div class="navigation-controls flex-wrap-row">
            <% UserTasks::CATEGORIES.each do |c| -%>
              <%= content_tag(:div, 'data-filter-category' => c, 'data-favorite' => true, 'class' => 'navigation-item') do -%>
                <%= hub_category_icon(c) %><%= c.humanize %><span class="category-count"></span>
              <% end -%>
            <% end %>
          </div>

          <span class="filter-title" data-help="Show only those features whose interfaces and functionality are at a certain level of completion. Red: expect major change; Yellow: functionality is more or less stable, form may change; Green: form and functionality are stable.">Status</span>
          <div class="filter-status">
            <button type="button" class="status-chip" data-filter-category="unknown" title="Unknown">
              <span class="status unknown"></span>Unknown
            </button>
            <button type="button" class="status-chip" data-filter-category="prototype" title="Prototype">
              <span class="status prototype"></span>Prototype
            </button>
            <button type="button" class="status-chip" data-filter-category="stable" title="Stable">
              <span class="status stable"></span>Stable
            </button>
            <button type="button" class="status-chip" data-filter-category="complete" title="Complete">
              <span class="status complete"></span>Complete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
