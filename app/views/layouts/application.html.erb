<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <%= title_tag -%>
 
    <% meta_data.each do |name, content| %>
      <% next if content.to_s.empty? || name.to_s.empty? %>
      <meta name="<%= name.to_s %>" content="<%= content.to_s %>">
    <% end %>

    <%= yield :head %>

    <%= favicon_link_tag asset_path('favicon.svg') %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbolinks-track" => true %>
    <%= stylesheet_pack_tag "tokens" %>
    <%= javascript_include_tag "theme" %>
    <% if sessions_signed_in? %>
      <%= javascript_include_tag "application", "data-turbolinks-track" => 'reload' %>
      <%= javascript_include_tag "separated_application", "data-turbolinks-track" => 'reload' %>
      <%= javascript_pack_tag "rspack", "application" %>
      <%= stylesheet_pack_tag "application" %>
    <% end %>

    <%= csrf_meta_tags %>

  </head>
  
  <body <%= turbolinks_off_tag -%> >
    <header>
      <div id="header-wrapper">
        <% if sessions_signed_in? %>
          <%= render partial: "news/system_news_bar", collection: system_news_bars, as: :news %>
        <% end %>
        <%= render(partial: 'sessions/summary') if sessions_signed_in? %>
      </div>
    </header>

    <nav>
      <%= quick_bar -%> 
      <%= task_bar -%>
      <%= slideouts -%>

    </nav>

    <div id="main">
      <aside class="alert-stack">
        <% flash.each do |key, value| %>
          <div class="alert alert-<%= key %>">
            <div class="message"><%= value %></div>
            <button type="button" class="alert-close" aria-label="Dismiss notification"></button>
          </div>
        <% end %>
      </aside>

      <%= yield %>
    </div>

  </body>
</html>