<%= form_for(@composition.metamorphosize) do |f| %>
  <%= render 'shared/errors', object: @composition %>

  <div class="required">
    <% if @composition.new_record? %>
      <div class="field">
        <%= f.label :type %>
        <br>
        <%= f.select :type, %w{Layout Template}, include_blank: true %>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name %>
      <br>
      <%= f.text_field :name %>
    </div>
  </div>

  <div class="field">
    <%= f.label :description %>
    <br>
    <%= f.text_area :description, rows: 5 %>
  </div>

  <% if @composition.class.community_permitted? %>
    <div class="field">
      <%= f.label :is_community, 'Share with all projects' %>
      <br>
      <%= f.check_box :is_community %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
