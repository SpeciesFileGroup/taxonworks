<div class="info-grid">
  <div class="info-item">
    <span class="info-label">Created by</span>
    <span class="info-value">
      <% if is_administrator? && object.creator %>
        <%= link_to(object_tag(object.creator), user_path(object.creator)) -%>
      <% else %>
        <%= object_tag(object.creator) -%>
      <% end %>
    </span>
  </div>

  <div class="info-item">
    <span class="info-label">Created at</span>
    <span class="info-value"><%= object.created_at.to_formatted_s(:long) -%></span>
  </div>

  <div class="info-item">
    <span class="info-label">Updated by</span>
    <span class="info-value">
      <% if is_administrator? && object.updater %>
        <%= link_to(object_tag(object.updater), user_path(object.updater)) -%>
      <% else %>
        <%= object_tag(object.updater) -%>
      <% end %>
    </span>
  </div>

  <div class="info-item">
    <span class="info-label">Updated at</span>
    <span class="info-value"><%= object.updated_at.to_formatted_s(:long) -%></span>
  </div>
</div>
